---
import { getCollection } from 'astro:content';
import WorkTemplate from '../../templates/Work.astro';
import { getWorks } from '../../lib/works';

export async function getStaticPaths() {
    const all = await getCollection('work');      // every page still gets a URL
    const visible = await getWorks();              // prev/next only walks the gallery

    return all.map((entry) => {
        const i = visible.findIndex((v) => v.slug === entry.slug);
        const next = i > 0 ? visible[i - 1] : null;
        const prev = i >= 0 && i < visible.length - 1 ? visible[i + 1] : null;
        return { params: { slug: entry.slug }, props: { entry, next, prev } };
    });
}

const { entry, next, prev } = Astro.props;
---

<WorkTemplate entry={entry} next={next} prev={prev} baseSlug="art" />
