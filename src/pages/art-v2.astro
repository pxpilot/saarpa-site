---
// Variation of the Art page: a salon-style wall.
// Works keep their own proportions and carry a small museum label underneath.
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const works = (await getCollection('work')).sort((a, b) =>
  new Date(b.data.date || 0).getTime() - new Date(a.data.date || 0).getTime()
);

const year = (d?: Date) => (d ? new Date(d).getFullYear() : null);
const medium = (desc?: string) => (desc ? desc.replace(/\.$/, '') : null);
---

<Layout title="Art" description="Paintings, machines and installations by Saar Paamoni.">
  <header class="wall-head">
    <h2 class="wall-title">Art</h2>
    <p class="wall-sub">{works.length} works · paintings, machines, installations</p>
  </header>

  <section class="wall">
    {works.map((w, i) => (
      <a href={`/art/${w.slug}`} class="piece" style={`--i:${i}`}>
        <figure>
          <div class="frame">
            {w.data.video ? (
              <video src={w.data.video} autoplay muted loop playsinline />
            ) : w.data.thumbnail ? (
              <img src={w.data.thumbnail} alt={w.data.title} loading="lazy" />
            ) : (
              <div class="blank" />
            )}
          </div>
          <figcaption>
            <span class="label-title">{w.data.title}</span>
            <span class="label-meta">
              {[medium(w.data.description), year(w.data.date)].filter(Boolean).join(' · ')}
            </span>
          </figcaption>
        </figure>
      </a>
    ))}
  </section>
</Layout>

<style>
  .wall-head {
    text-align: center;
    padding: 4rem var(--margin) 3rem;
  }
  .wall-title {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 4.2rem;
    margin: 0;
    color: var(--color-base);
  }
  .wall-sub {
    margin: 0.8rem 0 0;
    font-family: var(--font-sans-serif);
    font-size: 1.2rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-base);
    opacity: 0.6;
  }

  .wall {
    column-count: 3;
    column-gap: 4rem;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 4rem 6rem;
  }
  @media (max-width: 1000px) {
    .wall { column-count: 2; column-gap: 2.8rem; padding: 0 2.4rem 5rem; }
  }
  @media (max-width: 620px) {
    .wall { column-count: 1; padding: 0 1.6rem 4rem; }
  }

  .piece {
    display: block;
    break-inside: avoid;
    margin: 0 0 4.4rem;
    text-decoration: none;
    color: inherit;
    opacity: 0;
    animation: hang 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
    animation-delay: calc(var(--i) * 70ms);
  }
  @keyframes hang {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .piece { animation: none; opacity: 1; }
  }

  figure { margin: 0; }

  .frame {
    overflow: hidden;
    border-radius: 3px;
    background: var(--color-border);
    box-shadow: 0 1px 2px rgba(60, 40, 30, 0.08), 0 12px 28px -14px rgba(60, 40, 30, 0.35);
    transition: box-shadow 0.4s ease, transform 0.4s ease;
  }
  .frame img,
  .frame video {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .blank { aspect-ratio: 4 / 3; }

  .piece:hover .frame {
    transform: translateY(-3px);
    box-shadow: 0 2px 4px rgba(60, 40, 30, 0.1), 0 22px 40px -16px rgba(60, 40, 30, 0.45);
  }
  .piece:hover .frame img,
  .piece:hover .frame video {
    transform: scale(1.025);
  }

  figcaption {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.3rem 0.2rem 0;
    border-left: 2px solid transparent;
    transition: border-color 0.3s ease, padding 0.3s ease;
  }
  .piece:hover figcaption {
    border-left-color: var(--color-primary);
    padding-left: 1rem;
  }
  .label-title {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 2rem;
    line-height: 1.2;
    color: var(--color-base);
  }
  .piece:hover .label-title { color: var(--color-primary); }
  .label-meta {
    font-family: var(--font-sans-serif);
    font-size: 1.1rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-base);
    opacity: 0.55;
  }
</style>
