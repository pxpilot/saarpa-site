---
export interface Props {
    title?: string;
}

const { title } = Astro.props;

// Which nav item is the current page? /art/painting-machine counts as Art.
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) =>
    href === '/' ? path === '/' : path === href || path.startsWith(href + '/') || path.startsWith(href + '-');
const links = [
    { href: '/', label: 'Home' },
    { href: '/about', label: 'About' },
    { href: '/art', label: 'Art' },
    { href: '/consulting', label: 'Consulting' },
    { href: '/zen', label: 'Zen', disabled: true }, // greyed out until the Zen page works
    { href: '/contact', label: 'Contact' },
];
---
<header class="site-head">
    <div class="site-head-container">
        <a class="nav-burger" href="#">
            <div class="hamburger hamburger--collapse" aria-label="Menu" role="button" aria-controls="navigation">
                <div class="hamburger-box">
                    <div class="hamburger-inner" />
                </div>
            </div>
        </a>
        <nav id="swup" class="site-head-left">
            <ul class="nav" role="menu">
                {links.map(({ href, label, disabled }: { href: string; label: string; disabled?: boolean }) => (
                    <li class={`nav-home${isCurrent(href) ? ' nav-current' : ''}${disabled ? ' nav-disabled' : ''}`} role="menuitem">
                        <a href={disabled ? undefined : href} aria-disabled={disabled ? 'true' : undefined} title={disabled ? 'Coming soon' : undefined} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>
                    </li>
                ))}
            </ul>
        </nav>
        <div class="site-head-center">
            <a class="site-head-logo" href="/">Saar Paamoni</a>
        </div>
        <div class="site-head-right">
            <div class="social-links">
                <button id="theme-toggle" class="theme-toggle" aria-label="Toggle Dark Mode">
                    <svg class="sun-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
                    <svg class="moon-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
                </button>
            </div>
        </div>
    </div>
</header>

<style>
    /* Highlight the page you're on: burgundy, full strength, with a small underline */
    .nav-current a {
        color: var(--color-primary) !important;
        opacity: 1 !important;
        font-weight: 500 !important;
        position: relative;
    }
    .nav-current a::after {
        content: '';
        position: absolute;
        left: 12px;
        right: 12px;
        bottom: 4px;
        height: 2px;
        border-radius: 2px;
        background: var(--color-primary);
    }
    /* Greyed-out nav item (page not ready yet): grey and not clickable */
    .nav-disabled a {
        color: rgba(140, 140, 140, 0.55) !important;
        cursor: default;
        pointer-events: none;
    }
</style>
